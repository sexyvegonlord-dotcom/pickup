--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart
local startPosition

topBar.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end

        end)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,

            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )

    end

end)

--==================================================
-- FIND PROMPTS
--==================================================

local function getPrompts()

    local prompts = {}

    for _, object in ipairs(workspace:GetDescendants()) do

        if object:IsA("ProximityPrompt") then

            if object.Enabled then
                table.insert(prompts, object)
            end

        end

    end

    return prompts

end

--==================================================
-- DISTANCE CHECK
--==================================================

local function isNearby(prompt)

    local character = player.Character

    if not character then
        return false
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if not root then
        return false
    end

    local parent = prompt.Parent

    if not parent then
        return false
    end

    local part

    if parent:IsA("BasePart") then
        part = parent

    elseif parent:IsA("Attachment") then
        part = parent.Parent

    elseif parent:IsA("Model") then
        part = parent.PrimaryPart
            or parent:FindFirstChildWhichIsA("BasePart", true)
    end

    if not part or not part:IsA("BasePart") then
        return false
    end

    local distance = (root.Position - part.Position).Magnitude

    return distance <= MAX_DISTANCE

end

--==================================================
-- FIRE PROMPT
--==================================================

local function activatePrompt(prompt)

    if not prompt then
        return
    end

    if not prompt.Parent then
        return
    end

    if not prompt.Enabled then
        return
    end

    if not isNearby(prompt) then
        return
    end

    -- Executor-supported ProximityPrompt trigger
    pcall(function()

        if typeof(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
        end

    end)

end

--==================================================
-- UPDATE COUNT
--==================================================

local function updateCount()

    local count = 0

    for _, object in ipairs(workspace:GetDescendants()) do

        if object:IsA("ProximityPrompt") then
            count += 1
        end

    end

    countLabel.Text = "Proximity Prompts: " .. tostring(count)

end

--==================================================
-- AUTO PICKUP LOOP
--==================================================

task.spawn(function()

    while true do

        if autoPickup then

            local prompts = getPrompts()

            for _, prompt in ipairs(prompts) do

                if not autoPickup then
                    break
                end

                activatePrompt(prompt)

                task.wait(PICKUP_INTERVAL)

            end

        end

        task.wait(PICKUP_INTERVAL)

    end

end)

--==================================================
-- PROMPT DETECTION
--==================================================

workspace.DescendantAdded:Connect(function(object)

    if object:IsA("ProximityPrompt") then

        task.defer(updateCount)

    end

end)

workspace.DescendantRemoving:Connect(function(object)

    if object:IsA("ProximityPrompt") then

        task.defer(updateCount)

    end

end)

--==================================================
-- COUNT UPDATE
--==================================================

task.spawn(function()

    while true do

        updateCount()

        task.wait(1)

    end

end)

--==================================================
-- TOGGLE STATUS
--==================================================

local function setAutoPickup(state)

    autoPickup = state

    if autoPickup then

        statusLabel.Text = "●  AUTO PICKUP: ON"
        statusLabel.TextColor3 = Color3.fromRGB(70, 220, 100)

        infoLabel.Text = "Scanning nearby E prompts..."

    else

        statusLabel.Text = "●  AUTO PICKUP: OFF"
        statusLabel.TextColor3 = Color3.fromRGB(220, 70, 70)

        infoLabel.Text = "Press 9 to start picking up items"

    end

end

--==================================================
-- KEYBINDS
--==================================================

UserInputService.InputBegan:Connect(function(input, processed)

    if processed then
        return
    end

    -- 9 = TOGGLE AUTO PICKUP
    if input.KeyCode == TOGGLE_KEY then

        setAutoPickup(not autoPickup)

    end

    -- P = FORCE GUI VISIBLE
    if input.KeyCode == Enum.KeyCode.P then

        gui.Parent = playerGui
        gui.Enabled = true

        main.Visible = true
        topBar.Visible = true
        title.Visible = true
        subtitle.Visible = true
        statusLabel.Visible = true
        countLabel.Visible = true
        infoLabel.Visible = true

        gui.DisplayOrder = 999999

    end

end)

--==================================================
-- GUI WATCHDOG
--==================================================

task.spawn(function()

    while true do

        task.wait(0.25)

        -- Put GUI back into PlayerGui
        if gui.Parent ~= playerGui then
            gui.Parent = playerGui
        end

        -- Keep GUI enabled
        gui.Enabled = true

        -- Keep it above normal ScreenGuis
        gui.DisplayOrder = 999999

    end

end)

--==================================================
-- RESPAWN SUPPORT
--==================================================

player.CharacterAdded:Connect(function()

    task.wait(1)

    gui.Parent = playerGui
    gui.Enabled = true

end)

--==================================================
-- STARTUP
--==================================================

setAutoPickup(false)
updateCount()

print("† AUTO PICKUP CONTROLLER LOADED")
print("9 = Toggle Auto Pickup")
print("P = Force GUI Visible")
print("Reload-safe GUI = ON")
