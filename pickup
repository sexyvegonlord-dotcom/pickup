--==================================================
-- DRAGGING
--==================================================

local dragging = false
local dragStart
local startPosition

topBar.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1 then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end

        end)

    end

end)

UserInputService.InputChanged:Connect(function(input)

    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then

        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,

            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )

    end

end)

--==================================================
-- GET ROOT
--==================================================

local function getRoot()

    local character = player.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")

end

--==================================================
-- GET PROMPT POSITION
--==================================================

local function getPromptPosition(prompt)

    local parent = prompt.Parent

    if not parent then
        return nil
    end

    if parent:IsA("BasePart") then
        return parent.Position
    end

    if parent:IsA("Attachment") then
        return parent.WorldPosition
    end

    if parent:IsA("Model") then

        local part =
            parent.PrimaryPart
            or parent:FindFirstChildWhichIsA("BasePart", true)

        if part then
            return part.Position
        end

    end

    return nil

end

--==================================================
-- GET MAX 500 CLOSEST PROMPTS
--==================================================

local function getClosestPrompts()

    local root = getRoot()

    if not root then
        return {}
    end

    local promptData = {}

    -- Scan prompts
    for _, object in ipairs(workspace:GetDescendants()) do

        if object:IsA("ProximityPrompt")
            and object.Enabled then

            local position = getPromptPosition(object)

            if position then

                local distance =
                    (root.Position - position).Magnitude

                if distance <= MAX_DISTANCE then

                    table.insert(promptData, {
                        prompt = object,
                        distance = distance
                    })

                end

            end

        end

    end

    -- Sort closest first
    table.sort(promptData, function(a, b)
        return a.distance < b.distance
    end)

    -- Limit to 500
    local prompts = {}

    local amount =
        math.min(#promptData, MAX_PROMPTS)

    for i = 1, amount do
        prompts[i] = promptData[i].prompt
    end

    return prompts

end

--==================================================
-- ACTIVATE PROMPT
--==================================================

local function activatePrompt(prompt)

    if not prompt then
        return
    end

    if not prompt.Parent then
        return
    end

    if not prompt.Enabled then
        return
    end

    pcall(function()

        if typeof(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
        end

    end)

end

--==================================================
-- AUTO PICKUP LOOP
--==================================================

task.spawn(function()

    while true do

        if autoPickup then

            local prompts = getClosestPrompts()

            countLabel.Text =
                "Loaded: "
                .. tostring(#prompts)
                .. " / "
                .. tostring(MAX_PROMPTS)

            for _, prompt in ipairs(prompts) do

                if not autoPickup then
                    break
                end

                activatePrompt(prompt)

                task.wait(PICKUP_INTERVAL)

            end

        end

        task.wait(PICKUP_INTERVAL)

    end

end)

--==================================================
-- TOGGLE
--==================================================

local function setAutoPickup(state)

    autoPickup = state

    if autoPickup then

        statusLabel.Text = "●  AUTO PICKUP: ON"
        statusLabel.TextColor3 =
            Color3.fromRGB(70, 220, 100)

        infoLabel.Text =
            "Processing the 500 closest prompts..."

    else

        statusLabel.Text = "●  AUTO PICKUP: OFF"
        statusLabel.TextColor3 =
            Color3.fromRGB(220, 70, 70)

        infoLabel.Text =
            "Press 9 to start picking up items."

    end

end

--==================================================
-- KEYBINDS
--==================================================

UserInputService.InputBegan:Connect(function(input, processed)

    if processed then
        return
    end

    -- 9 = TOGGLE
    if input.KeyCode == TOGGLE_KEY then

        setAutoPickup(not autoPickup)

    end

    -- P = SHOW GUI
    if input.KeyCode == Enum.KeyCode.P then

        gui.Parent = playerGui
        gui.Enabled = true
        main.Visible = true

        gui.DisplayOrder = 999999

    end

end)

--==================================================
-- GUI WATCHDOG
--==================================================

task.spawn(function()

    while true do

        task.wait(0.25)

        if gui.Parent ~= playerGui then
            gui.Parent = playerGui
        end

        gui.Enabled = true
        gui.DisplayOrder = 999999

    end

end)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(function()

    task.wait(1)

    gui.Parent = playerGui
    gui.Enabled = true

end)

